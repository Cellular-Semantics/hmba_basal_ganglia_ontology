synonym: "granulocyte-macrophage progenitor" EXACT [ISBN:0721601464, PMCID:PMC2213186, PMCID:PMC548021]
synonym: "granulocyte/monocyte precursor" EXACT []
synonym: "granulocyte/monocyte progenitor" EXACT []
