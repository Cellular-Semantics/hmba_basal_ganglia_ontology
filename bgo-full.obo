[Term]
id: CL:0000232
name: erythrocyte
def: "A red blood cell. In mammals, mature erythrocytes are biconcave disks containing hemoglobin whose function is to transport oxygen." [GOC:tfm, MESH:D004912]
synonym: "RBC" EXACT []
synonym: "red blood cell" EXACT []
xref: BTO:0000424
xref: CALOHA:TS-0290
