    <!-- http://purl.obolibrary.org/obo/CL_0000030 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000030">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000255"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0011026"/>
