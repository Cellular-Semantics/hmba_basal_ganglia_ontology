        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_1001509"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The neurons that utilize glycine as a neurotransmitter.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>MP:0010385</oboInOwl:hasDbXref>
    </owl:Axiom>
