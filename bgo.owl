        <oboInOwl:hasDbXref>NCIT:C32488</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NLXANAT:090206</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:362301008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Dura_mater</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:1462</oboInOwl:hasDbXref>
