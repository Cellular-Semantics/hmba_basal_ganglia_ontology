    <!-- http://purl.obolibrary.org/obo/CL_2000046 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_2000046">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CL_0000746"/>
                    <owl:Restriction>
