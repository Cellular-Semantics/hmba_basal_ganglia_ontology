    <!-- http://purl.obolibrary.org/obo/GO_0005604 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0005604">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0031012"/>
        <obo:IAO_0000115>A collagen-containing extracellular matrix consisting of a thin layer of dense material found in various animal tissues interposed between the cells and the adjacent connective tissue. It consists of the basal lamina plus an associated layer of reticulin fibers.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>Wikipedia:Basement_membrane</oboInOwl:hasDbXref>
        <rdfs:comment>Note that this term has no relationship to &apos;membrane ; GO:0016020&apos; because the basement membrane is not a lipid bilayer.</rdfs:comment>
        <rdfs:label>basement membrane</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0005604"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A collagen-containing extracellular matrix consisting of a thin layer of dense material found in various animal tissues interposed between the cells and the adjacent connective tissue. It consists of the basal lamina plus an associated layer of reticulin fibers.</owl:annotatedTarget>
