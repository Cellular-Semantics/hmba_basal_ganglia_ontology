        </rdfs:subClassOf>
        <obo:IAO_0000115>The smooth muscle layer of the stomach wall that functions to churn and mix food and gastric secretions as well as to move food along the digestive tract to the intestines.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>FMA:14909</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:362132003</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>gastric muscularis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>muscle layer of stomach</oboInOwl:hasExactSynonym>
