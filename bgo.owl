        <oboInOwl:hasDbXref>SCTID:181371003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Brachiocephalic_vein</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>galen:BrachiocephalicVein</oboInOwl:hasDbXref>
