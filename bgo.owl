    <!-- http://purl.obolibrary.org/obo/GO_0030425 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0030425">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0043005"/>
        <rdfs:subClassOf>
            <owl:Restriction>
