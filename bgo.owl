            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The process whose specific outcome is the progression of the midbrain-hindbrain boundary over time, from its formation to the mature structure. The midbrain-hindbrain domain of the embryonic brain is comprised of the mesencephalic vesicle and the first rhombencephalic vesicle at early somitogenesis stages.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>MHB development</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>isthmic organizer development</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>isthmomesencephalic boundary development</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>isthmus development</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>midbrain-hindbrain orgainizer development</oboInOwl:hasExactSynonym>
        <rdfs:label>midbrain-hindbrain boundary development</rdfs:label>
    </owl:Class>
