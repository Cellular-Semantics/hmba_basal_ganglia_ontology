        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A non-terminally differentiated cell that is capable of developing into a muscle cell.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:add</oboInOwl:hasDbXref>
    </owl:Axiom>
