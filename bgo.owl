            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Any microtubule in the cytoplasm of a cell.</obo:IAO_0000115>
        <rdfs:label>cytoplasmic microtubule</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0005881"/>
