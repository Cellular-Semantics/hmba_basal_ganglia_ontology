                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002211"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0100001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Any process that modulates the frequency, rate or extent of skeletal muscle contraction by depolarization of muscle membrane and ionic fluxes.</obo:IAO_0000115>
        <rdfs:label>regulation of skeletal muscle contraction via regulation of action potential</rdfs:label>
    </owl:Class>
    <owl:Axiom>
