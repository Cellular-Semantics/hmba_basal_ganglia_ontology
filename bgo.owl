    <!-- http://purl.obolibrary.org/obo/CL_0020010 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0020010">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000617"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0012001"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_4023035"/>
