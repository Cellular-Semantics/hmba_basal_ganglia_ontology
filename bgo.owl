        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0021720"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The process that gives rise to the superior olivary nucleus. This process pertains to the initial formation of a structure from unspecified parts. In mice, the superior olivary nucleus is a small cylindrical mass on the dorsal surface of the lateral part of the trapezoid body of the pons, and it is situated immediately above the inferior olivary nucleus. It receives projections from the cochlear nucleus and thus is involved in the perception of sound.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:cls</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:dgh</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:dph</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:jid</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GO_REF:0000021</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ISBN:0838580343</oboInOwl:hasDbXref>
    </owl:Axiom>
    


