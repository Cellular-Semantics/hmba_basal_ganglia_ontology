        <oboInOwl:hasDbXref>PBA:128012596</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>CNU</oboInOwl:hasExactSynonym>
        <rdfs:comment>This was added as a more precise mapping to the Allen brain atlas (as opposed to collection of basal ganglia)</rdfs:comment>
        <rdfs:label>cerebral nuclei</rdfs:label>
        <skos:prefLabel>cerebral nuclei</skos:prefLabel>
    </owl:Class>
