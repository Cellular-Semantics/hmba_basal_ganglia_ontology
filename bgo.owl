        <oboInOwl:hasDbXref>DOI:10.1038/nrn.2017.68</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DOI:10.1111/j.1748-1716.2011.02308.x</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0000209"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
