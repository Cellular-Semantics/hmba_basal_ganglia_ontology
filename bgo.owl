        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0005583"/>
        <obo:IAO_0000115>A collagen homotrimer of alpha1(II) chains; type II collagen triple helices associate to form fibrils.</obo:IAO_0000115>
