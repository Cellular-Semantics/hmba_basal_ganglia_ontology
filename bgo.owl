        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002473"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0020003"/>
            </owl:Restriction>
        </rdf:type>
        <obo:RO_0015003 rdf:resource="https://purl.brain-bican.org/ontology/CS20250428/CS20250428_SUBCL_0007"/>
        <rdfs:label>GPi Core</rdfs:label>
        <taxonomy:cell_ontology_term>internal globus pallidus core projecting neuron</taxonomy:cell_ontology_term>
        <taxonomy:has_labelset rdf:resource="https://purl.brain-bican.org/ontology/CS20250428/Group"/>
        <taxonomy:marker_gene_evidence>Pvalb</taxonomy:marker_gene_evidence>
        <taxonomy:rationale>Mapping to the general GPi core cell type is based on location (to GPi, nested inside GPi shell neurons), predicted neurotransmitter (GABA), and expression of Pvalb.</taxonomy:rationale>
        <taxonomy:rationale_dois>https://doi.org/10.1016/j.neuron.2017.03.017</taxonomy:rationale_dois>
        <taxonomy:rationale_dois>https://doi.org/10.1523/ENEURO.0208-22.2022</taxonomy:rationale_dois>
        <taxonomy:synonyms>GPi Core</taxonomy:synonyms>
    </owl:NamedIndividual>
    


    <!-- https://purl.brain-bican.org/ontology/CS20250428/CS20250428_GROUP_0016 -->

    <owl:NamedIndividual rdf:about="https://purl.brain-bican.org/ontology/CS20250428/CS20250428_GROUP_0016">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/PCL_0010001"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002473"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0020004"/>
            </owl:Restriction>
        </rdf:type>
        <obo:RO_0015003 rdf:resource="https://purl.brain-bican.org/ontology/CS20250428/CS20250428_SUBCL_0014"/>
        <rdfs:label>GPi Shell</rdfs:label>
        <taxonomy:cell_ontology_term>internal globus pallidus shell projecting neuron</taxonomy:cell_ontology_term>
        <taxonomy:has_labelset rdf:resource="https://purl.brain-bican.org/ontology/CS20250428/Group"/>
        <taxonomy:marker_gene_evidence>Slc17a6</taxonomy:marker_gene_evidence>
        <taxonomy:marker_gene_evidence>Sst</taxonomy:marker_gene_evidence>
        <taxonomy:marker_gene_evidence>Tbr1</taxonomy:marker_gene_evidence>
        <taxonomy:rationale>Mapping to the general type GPi shell neuron (internal globus pallidus shell projection neuron) is based on soma location (to GPi &amp; surrounding GPi core neurons), neurotransmitter (dual GABA-Glut), expression of sst, Sst,Tbr1,Slc17a6 and absence of Pvalb expression.</taxonomy:rationale>
        <taxonomy:rationale_dois>https://doi.org/10.1016/j.neuron.2017.03.017</taxonomy:rationale_dois>
        <taxonomy:rationale_dois>https://doi.org/10.1523/ENEURO.0208-22.2022</taxonomy:rationale_dois>
        <taxonomy:synonyms>GPi Shell</taxonomy:synonyms>
    </owl:NamedIndividual>
    


