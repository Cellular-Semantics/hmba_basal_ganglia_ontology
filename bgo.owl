        <oboInOwl:hasExactSynonym>G-protein coupled receptor protein signaling pathway</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>G-protein coupled receptor signalling pathway</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>G-protein-coupled receptor protein signalling pathway</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>GPCR signaling pathway</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>GPCR signalling pathway</oboInOwl:hasExactSynonym>
        <rdfs:label>G protein-coupled receptor signaling pathway</rdfs:label>
    </owl:Class>
