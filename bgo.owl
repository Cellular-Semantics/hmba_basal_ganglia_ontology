                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001890"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The process whose specific outcome is the progression of the forebrain over time, from its formation to the mature structure. The forebrain is the anterior of the three primary divisions of the developing chordate brain or the corresponding part of the adult brain (in vertebrates, includes especially the cerebral hemispheres, the thalamus, and the hypothalamus and especially in higher vertebrates is the main control center for sensory and associative information processing, visceral functions, and voluntary motor functions).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>prosencephalon development</oboInOwl:hasExactSynonym>
        <rdfs:label>forebrain development</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0030900"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The process whose specific outcome is the progression of the forebrain over time, from its formation to the mature structure. The forebrain is the anterior of the three primary divisions of the developing chordate brain or the corresponding part of the adult brain (in vertebrates, includes especially the cerebral hemispheres, the thalamus, and the hypothalamus and especially in higher vertebrates is the main control center for sensory and associative information processing, visceral functions, and voluntary motor functions).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:4975589</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:4992177</oboInOwl:hasDbXref>
    </owl:Axiom>
    


