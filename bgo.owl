    <!-- http://purl.obolibrary.org/obo/CL_0013000 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0013000">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CL_0000681"/>
                    <owl:Restriction>
