        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>accessory neural nucleus</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FMA:83965</oboInOwl:hasDbXref>
    </owl:Axiom>
    


