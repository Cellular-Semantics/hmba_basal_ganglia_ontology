        <oboInOwl:hasDbXref>VSAO:0000040</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Cartilage</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0000170</oboInOwl:hasDbXref>
