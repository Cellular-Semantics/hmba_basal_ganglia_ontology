        <oboInOwl:hasDbXref>BAMS:Ventral_thalamus</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BIRNLEX:708</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BM:Die-VTh</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CALOHA:TS-2048</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DHBA:10461</oboInOwl:hasDbXref>
