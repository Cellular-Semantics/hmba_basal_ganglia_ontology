        <oboInOwl:hasDbXref>MA:0002866</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0005059</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0005059</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>myocardial trabecular layer</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>trabecular layer</oboInOwl:hasExactSynonym>
        <rdfs:label>myocardium trabecular layer</rdfs:label>
        <skos:prefLabel>myocardium trabecular layer</skos:prefLabel>
    </owl:Class>
