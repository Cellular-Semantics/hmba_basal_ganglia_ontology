        <oboInOwl:hasDbXref>MBA:672</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NLXANAT:100312</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>caudate putamen</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>caudateputamen</oboInOwl:hasExactSynonym>
