    <!-- http://purl.obolibrary.org/obo/GO_0005587 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0005587">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0098642"/>
