        <oboInOwl:hasDbXref>FBdv:00005317</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>OGES:000004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>OGES:000019</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WBls:0000010</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:1000005</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFS:0000047</oboInOwl:hasDbXref>
        <rdfs:label>gastrula stage</rdfs:label>
        <skos:prefLabel>gastrula stage</skos:prefLabel>
    </owl:Class>
