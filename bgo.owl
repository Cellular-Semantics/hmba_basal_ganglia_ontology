        </rdfs:subClassOf>
        <obo:IAO_0000115>The arachnoid barrier layer is a part of the arachnoid meningeal layer. It is formed by tight junctions between the endothelial cells of cerebral capillaries in the arachnoid mater.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BTO:0002498</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:231559</oboInOwl:hasDbXref>
        <rdfs:label>arachnoid barrier layer</rdfs:label>
    </owl:Class>
