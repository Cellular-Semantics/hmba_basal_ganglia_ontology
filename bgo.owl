        <oboInOwl:hasDbXref>GOC:mtg_muscle</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:11181628</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:11449884</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:12605307</oboInOwl:hasDbXref>
    </owl:Axiom>
    


