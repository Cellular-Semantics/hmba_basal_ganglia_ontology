    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004742"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The dentary is a dermal bone that forms the antero-lateral part of the lower jaw in fishes and amphibians, extending to the whole lower jaw in mammals[VHOG,modified].</owl:annotatedTarget>
        <oboInOwl:hasDbXref>VHOG:0001022</oboInOwl:hasDbXref>
