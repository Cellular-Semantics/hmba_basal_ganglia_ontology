        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The hemorrhoidal plexus (or rectal venous plexus) surrounds the rectum, and communicates in front with the vesical venous plexus in the male, and the uterovaginal plexus in the female. A free communication between the portal and systemic venous systems is established through the hemorrhoidal plexus.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Rectal_venous_plexus</oboInOwl:hasDbXref>
    </owl:Axiom>
    


