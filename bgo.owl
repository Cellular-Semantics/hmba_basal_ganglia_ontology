        <oboInOwl:hasDbXref>galen:Duodenum</oboInOwl:hasDbXref>
        <rdfs:label>duodenum</rdfs:label>
        <skos:prefLabel>duodenum</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002114"/>
