            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A component of a cell contained within (but not including) the plasma membrane. In eukaryotes it includes the nucleus and cytoplasm.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>Wikipedia:Intracellular</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>internal to cell</oboInOwl:hasExactSynonym>
