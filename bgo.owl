        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The reorganization or renovation of existing tissues. This process can either change the characteristics of a tissue such as in blood vessel remodeling, or result in the dynamic equilibrium of a tissue such as in bone remodeling.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:ebc</oboInOwl:hasDbXref>
    </owl:Axiom>
    


