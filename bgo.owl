    <!-- http://purl.obolibrary.org/obo/PATO_0000947 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0000947">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0002318"/>
        <obo:IAO_0000115>A spheroid quality inhering in a bearer by virtue of the bearer&apos;s being oval with two axes of symmetry, as produced by a conical section.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>ellipse-shaped</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ellipsoid</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>elliptical</oboInOwl:hasExactSynonym>
        <rdfs:label>elliptic</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0000947"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A spheroid quality inhering in a bearer by virtue of the bearer&apos;s being oval with two axes of symmetry, as produced by a conical section.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PATOC:GVG</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0000957 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0000957">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001300"/>
        <obo:IAO_0000115>An optical quality which obtains by virtue of the ability of the bearer to absorb visible light.</obo:IAO_0000115>
        <rdfs:label>opacity</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0000957"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An optical quality which obtains by virtue of the ability of the bearer to absorb visible light.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PATOC:GVG</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0000963 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0000963">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000957"/>
        <obo:IAO_0000115>A optical quality inhering in a bearer by virtue of the bearer&apos;s not being clear; not transmitting or reflecting light or radiant energy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>non-transparent</oboInOwl:hasExactSynonym>
        <rdfs:label>opaque</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0000963"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A optical quality inhering in a bearer by virtue of the bearer&apos;s not being clear; not transmitting or reflecting light or radiant energy.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PATOC:GVG</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0000964 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0000964">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000957"/>
        <obo:IAO_0000115>A optical quality inhering in a bearer by virtue of the bearer&apos;s lacking opacity.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>clear</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>hyaline</oboInOwl:hasExactSynonym>
        <rdfs:label>transparent</rdfs:label>
    </owl:Class>
