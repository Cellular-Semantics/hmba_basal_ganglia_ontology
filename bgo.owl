        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002473"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0020010"/>
            </owl:Restriction>
        </rdf:type>
