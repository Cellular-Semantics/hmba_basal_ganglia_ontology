        <oboInOwl:hasDbXref>CALOHA:TS-0935</oboInOwl:hasDbXref>
        <rdfs:label>skin fibroblast</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0002620</rdfs:seeAlso>
    </owl:Class>
