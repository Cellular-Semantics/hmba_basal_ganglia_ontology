    <!-- http://purl.obolibrary.org/obo/UBERON_0001049 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001049">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003914"/>
