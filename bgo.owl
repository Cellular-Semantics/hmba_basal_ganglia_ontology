    <!-- http://purl.obolibrary.org/obo/CL_2000008 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_2000008">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
