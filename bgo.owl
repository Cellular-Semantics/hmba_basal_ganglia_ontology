    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CL_0000119 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000119">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_4023057"/>
        <rdfs:subClassOf>
