                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002433"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002435"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A composite structure of the telencephalon that is defined in the striatopallidal system by connectivity and neurochemical staining. It includes the nucleus accumbens, the most ventral portions of the caudate nucleus and the putamen, the rostrolateral portion of the anterior perforated substance, the islands of Calleja and a rostral subcommissural portion of substantia innominata. The boundary between the ventral striatum and dorsal striatum is indistinct in sections stained for Nissl substance (Heimer-1995; adapted from Brain Info).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BAMS:STRv</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BAMS:StrV</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BAMS:Ventral_striatum</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BTO:0004702</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DMBA:15858</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EFO:0001936</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:36576</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:77614</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0002972</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MBA:493</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NLX:57107</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PBA:10091</oboInOwl:hasDbXref>
