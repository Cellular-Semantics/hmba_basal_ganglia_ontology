                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001046"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0006939"/>
