        <rdfs:label>GPe MEIS2-SOX6 GABA</rdfs:label>
        <taxonomy:cell_ontology_term>arkypallidal neuron</taxonomy:cell_ontology_term>
        <taxonomy:has_labelset rdf:resource="https://purl.brain-bican.org/ontology/CS20250428/Group"/>
        <taxonomy:marker_gene_evidence>FOXP2</taxonomy:marker_gene_evidence>
        <taxonomy:marker_gene_evidence>GAD1</taxonomy:marker_gene_evidence>
        <taxonomy:marker_gene_evidence>GAD2</taxonomy:marker_gene_evidence>
        <taxonomy:marker_gene_evidence>MEIS2</taxonomy:marker_gene_evidence>
        <taxonomy:marker_gene_evidence>NPAS1</taxonomy:marker_gene_evidence>
        <taxonomy:rationale>Mapping to the arkypallidal neuron is based on location (GPe), expression of GAD1/2, FOXP2, MEIS2, and NPAS1 and lack of expression of canonical pallidal markers NKX2-1 and LHX6, SST and PV.</taxonomy:rationale>
        <taxonomy:rationale_dois>https://doi.org/10.1016/j.neuron.2015.03.007</taxonomy:rationale_dois>
        <taxonomy:rationale_dois>https://doi.org/10.1038/s41593-023-01368-7</taxonomy:rationale_dois>
        <taxonomy:rationale_dois>https://doi.org/10.1523/JNEUROSCI.4662-14.2015</taxonomy:rationale_dois>
    </owl:NamedIndividual>
    


