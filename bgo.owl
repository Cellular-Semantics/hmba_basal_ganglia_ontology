    <!-- http://purl.obolibrary.org/obo/CL_0001035 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0001035">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CL_0000000"/>
                    <owl:Restriction>
