        <oboInOwl:hasDbXref>GOC:dph</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:tb</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ISBN:978-0-07-139011-8</oboInOwl:hasDbXref>
    </owl:Axiom>
    


