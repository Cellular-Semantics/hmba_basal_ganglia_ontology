    <!-- http://purl.obolibrary.org/obo/CL_1001509 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_1001509">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CL_0000540"/>
                    <owl:Restriction>
