        <oboInOwl:hasDbXref>FMA:242845</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Central_canal</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>cavity of central canal of spinal cord</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>central canal lumen</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>spinal cord lumen</oboInOwl:hasExactSynonym>
        <rdfs:label>lumen of central canal of spinal cord</rdfs:label>
        <skos:prefLabel>lumen of central canal of spinal cord</skos:prefLabel>
    </owl:Class>
