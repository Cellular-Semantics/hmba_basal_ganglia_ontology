        <oboInOwl:hasDbXref>CALOHA:TS-2159</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:14072</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>SMCs</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>myocytes, smooth muscle</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>smooth muscle fiber</oboInOwl:hasExactSynonym>
        <rdfs:label>smooth muscle cell</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0000192</rdfs:seeAlso>
        <skos:prefLabel>smooth muscle cell</skos:prefLabel>
    </owl:Class>
