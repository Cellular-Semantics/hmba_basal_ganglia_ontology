        <oboInOwl:hasDbXref>VHOG:0001113</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Jugular_foramen</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Posterior lacerate foramen</oboInOwl:hasExactSynonym>
