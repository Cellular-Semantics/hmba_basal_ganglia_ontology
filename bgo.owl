    <!-- http://purl.obolibrary.org/obo/CL_0000049 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000049">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002032"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/CL_0000050"/>
