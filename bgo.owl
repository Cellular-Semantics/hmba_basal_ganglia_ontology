                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_2759"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A microtubule in the axoneme of a eukaryotic cilium or flagellum; an axoneme contains nine modified doublet microtubules, which may or may not surround a pair of single microtubules.</obo:IAO_0000115>
        <rdfs:label>axonemal microtubule</rdfs:label>
    </owl:Class>
