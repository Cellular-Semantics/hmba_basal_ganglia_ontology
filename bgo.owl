        <oboInOwl:hasDbXref>FMA:70550</oboInOwl:hasDbXref>
        <rdfs:label>ependymal cell</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0000065</rdfs:seeAlso>
        <skos:prefLabel>ependymal cell</skos:prefLabel>
    </owl:Class>
