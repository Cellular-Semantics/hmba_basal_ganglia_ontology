            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The dorsal aorta is a blood vessel in a single-pass circulatory system that carries oxygenated blood from the gills to the rest of the body. In a single-pass circulatory system blood passes once through the heart to supply the body once.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>AAO:0011029</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BTO:0004673</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EHDAA:402</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:18606</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:338637006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0000014</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000264</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Dorsal_aorta</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0000051</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0000014</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>DA</oboInOwl:hasExactSynonym>
        <rdfs:label>dorsal aorta</rdfs:label>
        <skos:prefLabel>dorsal aorta</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005805"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The dorsal aorta is a blood vessel in a single-pass circulatory system that carries oxygenated blood from the gills to the rest of the body. In a single-pass circulatory system blood passes once through the heart to supply the body once.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GO:0035907</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://sourceforge.net/p/geneontology/ontology-requests/8525/</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
