        <oboInOwl:hasDbXref>EMAPA:32674</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:78447</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>HBA:9418</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0000818</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D002552</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C12356</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:180929003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:2497</oboInOwl:hasDbXref>
