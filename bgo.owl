    <!-- http://purl.obolibrary.org/obo/UBERON_0001040 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001040">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
