    <!-- http://purl.obolibrary.org/obo/UBERON_0002420 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002420">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003528"/>
