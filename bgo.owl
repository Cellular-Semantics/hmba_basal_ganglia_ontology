    <!-- http://purl.obolibrary.org/obo/UBERON_0010409 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0010409">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000063"/>
