# Genes and marker sets in the CL component must have a named superclass
# (SO:0000704 gene, SO:0001260 marker set), or they are orphans in CL (issue #12).
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?entity
WHERE {
  ?entity a owl:Class .
  FILTER(STRSTARTS(STR(?entity), "http://identifiers.org/ncbigene/") || STRSTARTS(STR(?entity), "http://purl.obolibrary.org/obo/CLM_"))
  FILTER NOT EXISTS { ?entity rdfs:subClassOf ?parent . FILTER(isIRI(?parent)) }
}
ORDER BY ?entity
