    <owl:Ontology rdf:about="http://purl.obolibrary.org/obo/pcl/bgo-base.owl">
        <owl:versionIRI rdf:resource="http://purl.obolibrary.org/obo/pcl/releases/2026-03-10/bgo-base.owl"/>
        <obo:IAO_0000700 rdf:resource="http://purl.obolibrary.org/obo/PCL_0160000"/>
