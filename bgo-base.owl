        <obo:IAO_0000700 rdf:resource="http://purl.obolibrary.org/obo/PCL_0160106"/>
        <dce:type rdf:resource="http://purl.obolibrary.org/obo/IAO_8000001"/>
        <dcterms:description>This ontology consists of terms generated from the HMBA basal ganglion taxonomy and reference data. The majority of terms including all group level terms have Cell Ontology IDs and are directly integrated into the Cell Ontology https://www.ebi.ac.uk/ols4/ontologies/cl.</dcterms:description>
        <dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:title>Basal Ganglia Ontology</dcterms:title>
        <owl:versionInfo>2026-03-10</owl:versionInfo>
    </owl:Ontology>
    


